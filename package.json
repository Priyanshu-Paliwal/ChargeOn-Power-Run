{
  "name": "chargeon-power-run",
  "private": true,
  "version": "2.0.0",
  "description": "ChargeOn Power Run - High Performance 3D Endless Runner Game",
  "author": "Cyntexa",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/checkAssetBudget.js && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:preview": "electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:win": "npm run build && electron-builder --win",
    "assets:check": "node scripts/checkAssetBudget.js",
    "characters:generate": "node scripts/generateCharacterAssets.js",
    "audio:generate": "node scripts/generateAudioAssets.js"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "gsap": "^3.12.5",
    "lil-gui": "^0.21.0",
    "pinia": "^2.2.0",
    "swiper": "^14.2.0",
    "three": "^0.160.0",
    "vue": "^3.4.15"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@vitejs/plugin-vue": "^5.0.3",
    "concurrently": "^10.0.5",
    "draco3dgltf": "^1.5.7",
    "electron": "^41.7.1",
    "electron-builder": "^26.13.0",
    "fbx2gltf": "^0.9.7-p1",
    "meshoptimizer": "^1.2.0",
    "sharp": "^0.35.3",
    "vite": "^5.0.11",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "@noble/hashes": "^1.4.0"
  },
  "build": {
    "appId": "com.cyntexa.chargeonpowerrun",
    "productName": "ChargeOn Power Run",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "public/img/chargeon-logo-badge-hd.png",
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/img/chargeon-logo-badge-hd.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  }
}
